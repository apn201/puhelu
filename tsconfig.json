{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["engine", "web", "tests", "vite.config.ts"]
}
